<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sfumato\Sfumato.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Sfumato.Tests\SampleWebsite\**\*">
            <Link>Fixtures\SampleWebsite\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
